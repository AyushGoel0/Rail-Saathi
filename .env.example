# Flask Configuration
SECRET_KEY=your_secret_key_here_generate_using_secrets_token_hex
FLASK_APP=app.app
FLASK_ENV=development

# Database Configuration
# For development (SQLite)
DATABASE_URL=sqlite:///instance/railsaathi.db

# For production (PostgreSQL) - uncomment and update
# DATABASE_URL=postgresql://username:password@host:port/database

# IRCTC API Configuration (RapidAPI)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=irctc1.p.rapidapi.com

# Session Configuration
SESSION_TIMEOUT=1800

# Email Configuration (Optional - for password recovery)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password

# Payment Gateway (Optional - Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# AI Features (Optional - OpenAI)
OPENAI_API_KEY=your_openai_api_key

# Application Settings
DEBUG=False
TESTING=False

# Security Headers
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env file to version control
# 4. Generate SECRET_KEY using: python -c "import secrets; print(secrets.token_hex(32))"
